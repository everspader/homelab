#!/bin/bash
# Invoke the Hermes CLI as the hermes service user.
#
# The hermes binary lives in /var/lib/hermes/.hermes/hermes-agent/venv/bin/
# and is owned by the hermes system user — the same user that runs
# hermes.service. The `home` user (the human operator) is granted
# password-less sudo for THIS BINARY ONLY via /etc/sudoers.d/50-hermes-cli.
# See host/hermes/sudoers.d/50-hermes-cli for the rule.
#
# `sudo -H` sets HOME=/var/lib/hermes so Hermes' default HERMES_HOME
# discovery lands on /var/lib/hermes/.hermes/ — matching the systemd
# unit's environment exactly. No drift between `systemctl restart hermes`
# and `hermes config` from the shell.
#
# CWD switch (important): sudo preserves the *calling* user's CWD by
# default. If `home` runs `hermes` from anywhere under /home/home/,
# the hermes process starts with CWD=/home/home/something — but the
# hermes user (deliberately) cannot read /home/home/ (mode 0750,
# group home, hermes not in that group). Hermes' project-root
# discovery (walking up looking for .git) then raises Permission
# denied on its first stat() call.
#
# Fix: cd to /opt/homelab before exec'ing sudo. /opt/homelab is
# world-traversable, the hermes user can read it, and it's the
# homelab repo — the most useful default project context for an
# agent meant to operate the homelab.
#
# To work in a different directory, drop into a hermes-user shell
# first:    sudo -u hermes -H bash
# then cd to wherever (must be hermes-readable) and run the binary
# directly at /var/lib/hermes/.hermes/hermes-agent/venv/bin/hermes.
cd /opt/homelab 2>/dev/null || cd /

# PTY allocation: Ubuntu 26.04 ships sudo-rs (the Rust rewrite) as the
# default sudo, and sudo-rs deliberately omits --use-pty. We still need
# a fresh PTY for the child — without one, the Hermes TUI's startup
# escape handshake (OSC 11 background-color query, etc.) races with
# whatever was buffered on the caller's TTY, and the terminal's response
# leaks into the input box as visible chars (`]11;rgb:...`).
#
# Workaround: wrap the sudo call in script(1) from util-linux. script
# allocates a fresh PTY, runs the command inside it, and proxies I/O
# between the user's terminal and the new PTY — same semantics as
# sudo --use-pty, just as a separate tool.
#
#   -q  quiet (no "Script started/done" messages)
#   -f  flush output after each write — required for live TUI redraws
#   -c  command to run inside the PTY
#   /dev/null  typescript output file (we don't want a transcript)
#
# Args are interpolated via printf %q so spaces, quotes, etc. in the
# user's args survive the shell expansion script's -c uses.
cmd=$(printf '%q ' \
  sudo --preserve-env=COLORTERM,LANG,LC_ALL,LC_CTYPE,LC_TERMINAL,TERM_PROGRAM,TERM_PROGRAM_VERSION \
  -u hermes -H \
  /var/lib/hermes/.hermes/hermes-agent/venv/bin/hermes "$@")
exec script -qfc "$cmd" /dev/null

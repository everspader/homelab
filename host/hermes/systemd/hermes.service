[Unit]
Description=Hermes personal assistant agent (gateway)
Documentation=https://github.com/NousResearch/hermes-agent
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple

# Dedicated system user — NOT the login user. The blast radius for an
# agent that processes untrusted input (channels, web fetches, tool
# results, prompt injection) is bounded to /var/lib/hermes/ plus
# whatever capability we explicitly grant later. The agent has no
# sudo, no SSH keys, no kubeconfig — these get added intentionally,
# never inherited.
User=hermes
Group=hermes
WorkingDirectory=/var/lib/hermes/.hermes/hermes-agent

# Env vars match what the Hermes installer's own user-level unit set.
# HERMES_HOME points at the writable state tree (sqlite dbs, .env,
# sessions, skills, memories). PATH must include the venv first so
# `python` resolves to the hermes-agent interpreter, not the system one.
Environment="PATH=/var/lib/hermes/.hermes/hermes-agent/venv/bin:/var/lib/hermes/.hermes/hermes-agent/node_modules/.bin:/var/lib/hermes/.hermes/node/bin:/var/lib/hermes/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=/var/lib/hermes/.hermes/hermes-agent/venv"
Environment="HERMES_HOME=/var/lib/hermes/.hermes"

# `--replace` evicts any stale gateway holding gateway.lock — lets
# `systemctl restart` cut over without manual lock cleanup.
ExecStart=/var/lib/hermes/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main gateway run --replace

# SIGUSR1 = live config reload. `systemctl reload hermes` after editing
# /var/lib/hermes/.hermes/config.yaml on the box — no connection drop.
ExecReload=/bin/kill -USR1 $MAINPID

# Hermes loads /var/lib/hermes/.hermes/.env itself — do NOT add
# EnvironmentFile= here, would duplicate config and risk drift.

Restart=always
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=300
# Exit code 75 = "restart me, this was intentional" (Hermes convention).
RestartForceExitStatus=75

KillMode=mixed
KillSignal=SIGTERM
# Hermes drains gateway connections + checkpoints sqlite state.db on
# shutdown. The installer's own unit uses 210s — match it. Going lower
# risks SIGKILL mid-flush and a corrupted state.db-wal.
TimeoutStopSec=210

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes

# Files the service creates default to 0600 — sensitive by default,
# loosen per-file if needed.
UMask=0077

# ───────── Hardening ─────────
# Filesystem confinement: the agent can only write to its own state dir.
# /home is invisible (would otherwise expose /home/home/.ssh, kubeconfig,
# shell history, etc.). /usr, /etc, /boot, /var/* are read-only via
# ProtectSystem=strict.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/hermes

# Hide other processes from /proc. The agent can see its own pids
# (ProcSubset=pid), but not what the rest of the host is doing.
ProtectProc=invisible
ProcSubset=pid

# Capability dropping — Python user-space agent needs none of these
# (no raw sockets, no setuid, no chroot, no kernel module loading).
CapabilityBoundingSet=
AmbientCapabilities=

# Device access — closed. Hermes is headless on this box (no audio,
# no camera). If it ever needs /dev/foo, allow it specifically.
DevicePolicy=closed

# General kernel-surface hardening (safe defaults for any user-space agent).
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
SystemCallArchitectures=native

# Deliberately NOT setting: RestrictNamespaces, ProtectControlGroups —
# would likely break Hermes' sandboxes/ feature (uses Linux namespaces +
# cgroups to isolate tool execution from itself). Tighten later if you
# confirm sandboxes/ doesn't depend on them.

[Install]
WantedBy=multi-user.target

[Unit]
Description=Hermes personal assistant agent (gateway)
Documentation=https://github.com/NousResearch/hermes-agent
After=network-online.target
Wants=network-online.target
# Never give up on restarts — this is a personal assistant, always-on.
StartLimitIntervalSec=0

[Service]
Type=simple
User=home
Group=home
WorkingDirectory=/home/home/.hermes/hermes-agent

# Env vars the Hermes installer's own unit sets — required for the venv
# launcher + data dir discovery. HERMES_HOME points at the writable state
# tree (sqlite dbs, sessions, skills, .env).
Environment="PATH=/home/home/.hermes/hermes-agent/venv/bin:/home/home/.hermes/hermes-agent/node_modules/.bin:/home/home/.hermes/node/bin:/home/home/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=/home/home/.hermes/hermes-agent/venv"
Environment="HERMES_HOME=/home/home/.hermes"

# `--replace` evicts any stale gateway holding /home/home/.hermes/gateway.lock,
# which lets `systemctl restart` cut over cleanly.
ExecStart=/home/home/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main gateway run --replace

# Hermes supports SIGUSR1 for live config reload (e.g. after editing
# /home/home/.hermes/config.yaml) — `systemctl reload hermes` triggers this
# without dropping in-flight gateway connections.
ExecReload=/bin/kill -USR1 $MAINPID

# Hermes loads /home/home/.hermes/.env itself — do NOT add EnvironmentFile=,
# that would duplicate config and risk drift.

Restart=always
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=300
# Exit code 75 = "restart me, this was intentional" (Hermes convention).
RestartForceExitStatus=75

KillMode=mixed
KillSignal=SIGTERM
# Hermes drains gateway connections + flushes state.db on shutdown; the
# installer's own unit uses 210s, so match it. Going lower risks SIGKILL
# mid-flush and a corrupted state.db-wal.
TimeoutStopSec=210

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes

# Hardening — chosen NOT to break an agent that (a) needs the user's
# tooling (kubectl, etc.) and (b) uses Linux namespaces/cgroups for its
# own sandboxes/ feature. Tighten further once stable.
#
# NoNewPrivileges=true blocks sudo. If Hermes is later wired to run
# privileged homelab ops via sudo, flip this to false.
NoNewPrivileges=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
RestrictRealtime=true
SystemCallArchitectures=native
# Deliberately NOT set: RestrictNamespaces, ProtectControlGroups,
# ProtectSystem, ProtectHome, PrivateTmp — would likely break sandboxes/
# or filesystem access the agent needs.

[Install]
WantedBy=multi-user.target

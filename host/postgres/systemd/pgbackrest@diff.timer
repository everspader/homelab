[Unit]
Description=Daily pgBackRest differential backup
Documentation=https://pgbackrest.org/

[Timer]
# Daily at 03:30 UTC. After the weekly full (02:00 Sundays), so Sunday's diff
# runs against a fresh full and stays small.
OnCalendar=*-*-* 03:30:00
# If the box was off at the scheduled time, run on next boot.
Persistent=true
# Smear up to 5 min to avoid coinciding with other 03:30 timers.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
